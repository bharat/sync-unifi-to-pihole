# Sync Settings
DOMAIN=home.example.com
LOG_LEVEL=info

# UniFi OS Configuration (UDM, UDM Pro, UDM SE, Cloud Gateway, etc.)
UNIFI_IP=192.168.0.1
UNIFI_USER=dns-sync
UNIFI_PASSWORD=your_unifi_password_here

# Pi-hole Configuration
PIHOLE_IP=192.168.0.19
PIHOLE_PASSWORD=your_pihole_password_here

# Cloudflare Configuration (optional — omit to skip Cloudflare sync)
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# with Zone:DNS:Edit permission scoped to your zone.
#CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
#CLOUDFLARE_ZONE_ID=your_zone_id_here
